# Optional, for local development with `npm run dev` only.
# Copy to .env.local (ignored by git). Vite inlines VITE_* variables into the
# built bundle, so never run `npm run build`, `npm run deploy` or `docker build`
# with this set. The recommended option is the in-app Settings modal.
VITE_OPENAI_API_KEY=your-openai-api-key
